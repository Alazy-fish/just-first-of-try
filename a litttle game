/* ============================================================
 *  数学 / 随机
 * ============================================================ */
int   rand_range(int min, int max);
float rand_float(void);
int   roll_percent(int percent);
float clampf(float v, float lo, float hi);
float lerpf(float a, float b, float t);

/* ============================================================
 *  GDI 绘图基础 (render.c)
 * ============================================================ */

/* 释放绘图缓存 (画刷 / 字体 / 渐变位图), 程序退出前调用 */
void  render_release_caches(void);
void  render_release_gradients(void);

void  fill_rect(HDC hdc, float x, float y, float w, float h, COLORREF c);
void  fill_rect_alpha(HDC hdc, float x, float y, float w, float h,
                      COLORREF c, int alpha);
void  fill_round_rect(HDC hdc, float x, float y, float w, float h,
                      float radius, COLORREF c);
void  draw_text(HDC hdc, float x, float y, const char *text,
                COLORREF color, int size, int bold, int align);
void  draw_text_wide(HDC hdc, float x, float y, const wchar_t *text,
                     COLORREF color, int size, int bold, int align);
float text_width(HDC hdc, const char *text, int size, int bold);
void  draw_hp_bar(HDC hdc, float x, float y, float w, float h,
                  int hp, int maxHp);

/* ---- 美术增强工具 (render.c) ---- */
/* 垂直渐变矩形 */
void  fill_grad_rect(HDC hdc, float x, float y, float w, float h,
                     COLORREF top, COLORREF bottom);
/* 带描边的面板: 投影 + 填充 + 外框 + 顶部高光 */
void  fill_panel(HDC hdc, float x, float y, float w, float h,
                 float radius, COLORREF fill, COLORREF border);
/* 带描边的实心圆 (用于角色/装饰, 提升可读性) */
