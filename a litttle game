                      COLORREF fill, COLORREF outline, float outlineW);
/* 带描边的圆角矩形 */
void  fill_round_rect_out(HDC hdc, float x, float y, float w, float h,
                          float radius, COLORREF fill, COLORREF outline);
/* 文字 + 深色投影 */
void  draw_text_sh(HDC hdc, float x, float y, const char *text,
                   COLORREF color, int size, int bold, int align);
/* 颜色工具 */
COLORREF color_lerp(COLORREF a, COLORREF b, float t);
COLORREF color_shade(COLORREF c, float k);
int   draw_text_wrap(HDC hdc, float x, float y, float maxW, const char *text,
                     COLORREF color, int size, int lineHeight, int maxLines);

/* ============================================================
 *  场景
 * ============================================================ */
typedef enum {
    SCENE_TITLE = 0,      /* 标题画面 */
    SCENE_OVERWORLD,      /* 大地图探索 */
    SCENE_BATTLE          /* 战斗 */
} Scene;

extern Scene g_scene;

/* 标题画面是否处于"覆盖存档"确认状态 (0=正常 1=确认) */
extern int g_titleConfirm;

/* ============================================================
 *  属性 / 角色
 * ============================================================ */
typedef struct {
    int hp;
    int maxHp;
    int atk;
    int def;
    int speed;
} Stats;

typedef struct {
    char     name[MAX_NAME_LEN];
    Stats    stats;
    int      alive;
    int      isPlayer;         /* 1=玩家 0=电脑 */
    int      defending;
    COLORREF color;            /* 主体颜色 */

    /* 战斗动画 */
    float    x, y;
    float    baseX, baseY;
    float    offsetX;
    float    shakeTimer;
    float    flashTimer;
    float    defendGlow;
    float    bobPhase;

    /* 统计 */
    int      totalDamageDealt;
    int      totalDamageTaken;
    int      hits;
    int      crits;
    int      blocks;
    int      dodges;
} Fighter;

/* ============================================================
 *  敌人种类 (野外怪物 / 挑战者)
 * ============================================================ */
typedef struct {
    const char *name;
    int         hp, atk, def, speed;
    int         exp;           /* 战胜后获得经验 */
    int         gold;          /* 战胜后获得金币 */
    COLORREF    color;
} EnemyType;

const EnemyType *enemy_get(int index);
int              enemy_count(void);
void             enemy_make(int index, int level, Fighter *out);

/* 角色操作 */
void  fighter_init(Fighter *f, const char *name, int isPlayer,
                   int maxHp, int atk, int def, int speed);
int   fighter_is_alive(const Fighter *f);
void  fighter_reset_anim(Fighter *f);
void  fighter_update(Fighter *f, float dt);

/* ============================================================
 *  战斗日志
 * ============================================================ */
typedef struct {
    char lines[MAX_LOG_LINES][MAX_LOG_LEN];
    int  count;
} BattleLog;

void  log_init(BattleLog *log);
void  log_add(BattleLog *log, const char *fmt, ...);

/* ============================================================
 *  特效
 * ============================================================ */
typedef struct {
    float    x, y;
    float    vy;
    float    life, maxLife;
    char     text[40];
    COLORREF color;
    int      big;
} FloatText;

typedef struct {
    float    x, y;
    float    vx, vy;
    float    life;
    COLORREF color;
    int      active;
} Particle;

#define MAX_FLOATS     24
#define MAX_PARTICLES  64

void  floats_clear(void);
void  float_add(float x, float y, COLORREF color, int big,
                const char *fmt, ...);
void  floats_update(float dt);
void  particles_clear(void);
void  particles_burst(float x, float y, COLORREF color, int count);
void  particles_update(float dt);

/* ============================================================
 *  战斗
 * ============================================================ */
typedef enum {
    ACTION_NONE = 0,
    ACTION_ATTACK,
    ACTION_DEFEND,
    ACTION_FLEE
} Action;

typedef enum {
    HIT_NORMAL = 0,
    HIT_CRIT,
    HIT_BLOCKED,
    HIT_DODGED,
    HIT_DEFENDED,
    HIT_COUNTER
} HitResult;

typedef enum {
    PHASE_PLAYER_TURN = 0,
    PHASE_RESOLVE,
    PHASE_ENEMY_TURN,
    PHASE_WIN,
    PHASE_LOSE,
    PHASE_FLED
} BattlePhase;

typedef struct {
    BattlePhase phase;
    Fighter     player;
    Fighter     enemy;

    Action      playerAction;
    Action      enemyAction;
    int         playerActed;
    int         enemyActed;
    int         round;

    /* 动画状态机 */
    float       animTimer;
    int         animStage;      /* 0=挥击 1=命中 2=归位 */
    Fighter    *attacker;
    Fighter    *defender;

    /* 特效 */
    FloatText   floats[MAX_FLOATS];
    int         floatCount;
    Particle    particles[MAX_PARTICLES];
    BattleLog   log;

    /* 战斗结果 */
    int         isBoss;         /* 挑战者战 (非野生) */
    int         foeNpcIdx;      /* 对应的大地图 NPC 索引, -1 表示野生 */
    int         expReward;
    int         goldReward;
    int         rewardGiven;
    char        foeLabel[MAX_NAME_LEN];

    /* 鼠标 */
    int         mouseX, mouseY;
    int         mouseDown;

    float       totalTime;
} Game;

extern Game g_game;

void  game_init(void);
void  game_start_battle(int enemyIndex, int isBoss, const char *foeName);
void  game_player_choose(Action a);
void  game_update(float dt);
int   calc_damage(const Fighter *attacker, const Fighter *defender,
                  int *isCrit, int *isBlocked, float extraReduce);

/* ============================================================
 *  战斗渲染 (render.c)
 * ============================================================ */
void  render_title(HDC hdc);
void  render_battle(HDC hdc);
void  render_battle_overlay(HDC hdc);

/* ---- 标题画面按钮命中检测 (render.c 定义, main.c 使用) ---- */
int   title_hit_continue(int px, int py);       /* 继续冒险 */
int   title_hit_new(int px, int py);            /* 新的冒险 */
int   title_hit_confirm_ok(int px, int py);     /* 确认覆盖 */
int   title_hit_confirm_cancel(int px, int py); /* 取消 */

#endif /* GAME_H */
