#ifndef GAME_H
#define GAME_H

/*
 * ============================================================
 *  口袋冒险 - Pocket Adventure
 * ------------------------------------------------------------
 *  一个类口袋妖怪的 RPG 小游戏 (C 语言 + Win32 API + GDI)
 *
 *  玩法:
 *    操控小人在大地图上走动, 在草丛中遭遇野生精灵,
 *    进入回合制战斗, 通过 攻击/防御/逃跑 战胜对手并成长.
 *
 *  编译环境: Visual Studio 2022
 * ============================================================
 */

#define _CRT_SECURE_NO_WARNINGS
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
